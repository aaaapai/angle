# ============================================================
#  args.gn.in  -  ANGLE 参数模板
#
#    本文件不是 GN 语法！由 scripts/gen_args.sh 读取合并后，
#    输出扁平 key=value 的 out/<out-dir>/args.gn 交给 GN。
#
#  section 优先级（后者覆盖前者同名 key）：
#      platform-*  >  mode-*  >  arch-*  >  base
#
#  即：同名 key 出现在多个 section 时，优先级高的生效
#     （platform 里可以覆盖 mode / arch / base 的同名 key）
#
#  polly：mode-release 的 cflags 里放 #@POLLY@ 占位符，
#         由 gen_args.sh 在 release 且非 iOS 时替换为插件参数，
#         其余情况删除该行。
#
#  约定：
#   - section 头：`# ==SECTION:name==`（整行）
#   - key 行：`key = value`；数组值以 `[` 开始、单独一行 `]` 结束
# ============================================================


# ==SECTION:base==
is_component_build = false
is_clang = true
jobs = 6
use_goma = false
use_lld = true
use_mold = false

cc_wrapper = "ccache"
c_wrapper = "ccache"

enable_resource_allowlist_generation = false
generate_debug_info = false

use_cxx23 = true
use_custom_libcxx = true
use_custom_libcxx_for_host = false
libcxx_abi_unstable = true
rust_lto = "fat"

use_clang_coverage = false
optimize_for_fuzzing = false
use_dummy_lastchange = false
treat_warnings_as_errors = false

angle_build_all = false
angle_build_tests = false
build_angle_deqp_tests = false
angle_expose_non_conformant_extensions_and_versions = true
angle_ir = false
angle_standalone = false
angle_enable_explicit_context = true

angle_enable_vulkan = true
angle_enable_vulkan_validation_layers = false
angle_enable_vulkan_shared_ring_buffer_cmd_alloc = true
angle_enable_d3d11 = false
angle_enable_null = false
angle_enable_wgpu = false
angle_enable_cl = false
angle_enable_swiftshader = false

# 后端默认值：GL 开启，Metal 关闭（iOS 在 platform-ios 覆盖）
angle_enable_gl = true
angle_enable_glsl = true
angle_enable_essl = true
angle_enable_metal = false
angle_enable_msl = false


# ==SECTION:mode-release==
# -------- release --------
is_debug = false
symbol_level = 0
dcheck_always_on = false
angle_assert_always_on = false
enable_iterator_debugging = false
enable_stripping = true
strip_debug_info = true
exclude_unwind_tables = true
use_lto = true
use_rtti = false

angle_has_frame_capture = false
angle_force_context_check_every_call = false
angle_enable_perf_counter_output = false
angle_enable_trace = false

angle_extra_cflags = [
  "-Wno-error=unused-variable",
  "-Wno-error=extra-semi-stmt",
  "-Wno-error=unsafe-buffer-usage",
  "-Wno-error",
  "-O3",
  "-mllvm",
  "-hot-cold-split=true",
  "-fdata-sections",
  "-ffunction-sections",
  "-fmerge-all-constants",
  "-ftree-vectorize",
  "-fvectorize",
  "-fslp-vectorize",
  "-pipe",
  "-integrated-as",
  "-mllvm",
  "-inlinehint-threshold=1000",
  "-flto",
  "-D_FILE_OFFSET_BITS=64",
  "-D__USE_BSD",
  "-D_ALLBSD_SOURCE",
  #@POLLY@
]

angle_extra_cflags_cc = [
  "-Wno-error=unused-variable",
  "-Wno-error=extra-semi-stmt",
  "-Wno-error=unsafe-buffer-usage",
  "-Wno-error",
  "-O3",
  "-mllvm",
  "-hot-cold-split=true",
  "-fdata-sections",
  "-ffunction-sections",
  "-fmerge-all-constants",
  "-ftree-vectorize",
  "-fvectorize",
  "-fslp-vectorize",
  "-pipe",
  "-integrated-as",
  "-mllvm",
  "-inlinehint-threshold=1000",
  "-flto",
  "-D_FILE_OFFSET_BITS=64",
  "-D__USE_BSD",
  "-D_ALLBSD_SOURCE",
  "-DUNSAFE_BUFFERS_BUILD",
  #@POLLY@
]

angle_extra_ldflags = [
  "-fuse-ld=lld",
  "-Wl,--gc-sections",
  "-flto",
  "-Wl,--lto-O3",
  "-Wl,-O3",
  "-Wl,--as-needed",
]


# ==SECTION:mode-debug==
# -------- debug --------
is_debug = true
symbol_level = 2
dcheck_always_on = true
angle_assert_always_on = true
enable_iterator_debugging = true
enable_stripping = true
strip_debug_info = false
exclude_unwind_tables = false
use_lto = false
use_rtti = true

angle_has_frame_capture = true
angle_force_context_check_every_call = true
angle_enable_perf_counter_output = true
angle_enable_trace = true

angle_extra_cflags = [
  "-Wno-error=unused-variable",
  "-Wno-error=extra-semi-stmt",
  "-Wno-error=unsafe-buffer-usage",
  "-Wno-error",
  "-g",
  "-O1",
  "-D_FILE_OFFSET_BITS=64",
  "-D__USE_BSD",
  "-D_ALLBSD_SOURCE",
  "-DANGLE_ENABLE_DEBUG_ANNOTATIONS",
]

angle_extra_cflags_cc = [
  "-g",
  "-Wno-error=unused-variable",
  "-Wno-error=extra-semi-stmt",
  "-Wno-error=unsafe-buffer-usage",
  "-Wno-error",
  "-O1",
  "-D_FILE_OFFSET_BITS=64",
  "-D__USE_BSD",
  "-D_ALLBSD_SOURCE",
  "-DANGLE_ENABLE_DEBUG_ANNOTATIONS",
]

angle_extra_ldflags = [
  "-fuse-ld=lld",
  "-Wl,--gc-sections",
  "-Wl,--as-needed",
]


# ==SECTION:mode-fastdebug==
# -------- fastdebug--------
is_debug = true
symbol_level = 2
dcheck_always_on = true
angle_assert_always_on = true
enable_iterator_debugging = true
enable_stripping = true
strip_debug_info = false
exclude_unwind_tables = false
use_lto = true
use_rtti = true

angle_has_frame_capture = true
angle_force_context_check_every_call = true
angle_enable_perf_counter_output = true
angle_enable_trace = true
angle_always_log_info = true
angle_enable_unwind_backtrace_support = true

# --- Vulkan 错误与内存可观测性 ---
angle_enable_vulkan_validation_layers = true    # 编译并启用 Vulkan 验证层
angle_enable_vulkan_api_dump_layer = true       # 编译 API 转储层（运行时可开关）
angle_enable_unwind_backtrace_support = true    # 错误附带调用栈

# --- 跟踪与日志：全量开启，不走 logcat ---
angle_enable_trace = true                       # 记录每条 GLES/EGL API 命令
angle_enable_trace_events = true                # 启用 Perfetto/platform trace events
angle_enable_trace_android_logcat = false       # 明确切断 logcat 路径
angle_always_log_info = true                    # 输出 INFO 级上下文，淹没关键错误也接受

# --- 帧捕获（RenderDoc 依赖 Vulkan 验证层）---
angle_enable_renderdoc = true                   # 编译 RenderDoc 捕获支持

# --- 内存分配追踪 ---
angle_enable_memory_alloc_logging = true        # 启用内存分配/释放日志
# angle_use_partition_alloc 保持 base 中的 false：独立 ANGLE 构建不链接 Chromium PartitionAlloc

# --- 调试辅助 ---
angle_has_frame_capture = true
angle_force_context_check_every_call = true
angle_enable_perf_counter_output = true

angle_extra_cflags = [
  "-Wno-error=unused-variable",
  "-Wno-error=extra-semi-stmt",
  "-Wno-error=unsafe-buffer-usage",
  "-Wno-error",
  "-g",
  "-O2",
  "-D_FILE_OFFSET_BITS=64",
  "-D__USE_BSD",
  "-D_ALLBSD_SOURCE",
  "-DANGLE_ENABLE_DEBUG_ANNOTATIONS",
]

angle_extra_cflags_cc = [
  "-g",
  "-Wno-error=unused-variable",
  "-Wno-error=extra-semi-stmt",
  "-Wno-error=unsafe-buffer-usage",
  "-Wno-error",
  "-O2",
  "-D_FILE_OFFSET_BITS=64",
  "-D__USE_BSD",
  "-D_ALLBSD_SOURCE",
  "-DANGLE_ENABLE_DEBUG_ANNOTATIONS",
]

angle_extra_ldflags = [
  "-fuse-ld=lld",
  "-Wl,--gc-sections",
  "-Wl,--as-needed",
]


# ==SECTION:platform-android==
# -------- Android：只用 base 默认后端，仅补 target_os 等 --------
target_os = "android"
android_ndk_api_level = 26
angle_use_android_tls_slot = true
enable_unused_resource_stripping = true


# ==SECTION:platform-ios==
target_os = "ios"
target_environment = "device"
ios_enable_code_signing = false
enable_unused_resource_stripping = false


# 保持 Chromium 自带 libc++（base 的 use_custom_libcxx = true）。
# 关掉它会让 bundled libc++abi 在缺少 -nostdinc++ / -isystem 的情况下继续参与编译，
# 从而落到 Xcode SDK 的旧 cxxabi.h 上（__ptrauth_cxxabi_* 等宏缺失，编译失败）。

# iOS 仅保留 Metal 后端。
# GL/Vulkan 全部关闭；GLSL/ESSL 不能关，Metal 后端用它们作为输入翻译成 MSL。
angle_enable_vulkan = false
angle_enable_vulkan_validation_layers = false
angle_enable_vulkan_shared_ring_buffer_cmd_alloc = false
angle_enable_gl = false
angle_enable_gl_desktop_backend = false
angle_enable_metal = true
angle_enable_msl = true


# iOS 不 strip framework，保留完整符号
enable_stripping = false
strip_debug_info = false

# iOS ldflags
angle_extra_ldflags = [
  "-fuse-ld=lld",
  "-flto",
  "-Wl,-O3",
]


# ==SECTION:platform-linux==
target_os = "linux"
angle_use_wayland = true
ozone_auto_platforms = true
angle_use_x11 = true
enable_unused_resource_stripping = true
angle_enable_cl = true
angle_enable_wgpu = true
use_ozone = false

# ==SECTION:arch-arm64==
target_cpu = "arm64"
arm_use_neon = true
arm_version = 8
ios_deployment_target = "12.0"


# ==SECTION:arch-arm32==
target_cpu = "arm"
arm_use_neon = true
arm_version = 7
arm_use_thumb = false


# ==SECTION:arch-x86==
target_cpu = "x86"


# ==SECTION:arch-x64==
target_cpu = "x64"
